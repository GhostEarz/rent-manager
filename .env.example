# Postgres connection (use the pooled string on Vercel/Neon)
DATABASE_URL=postgres://user@localhost:5432/rent_manager
# "true" for managed Postgres that requires SSL (Neon, RDS)
DB_SSL=false
# openssl rand -base64 32
AUTH_SECRET=
# Protects POST /api/cron/generate-charges
CRON_SECRET=
# Used only by `npm run seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
